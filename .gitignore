# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/
.env/

# 缓存
data/cache/*.pkl
!data/cache/.gitkeep

# 数据库文件
data/db/*.db
data/db/*.db-shm
data/db/*.db-wal
!data/db/.gitkeep

# 日志
logs/*.log
!logs/.gitkeep

# 输出文件
output/reports/*
output/dashboards/*
output/tier2/*
output/tier3/*
!output/reports/.gitkeep
!output/dashboards/.gitkeep
!output/tier2/.gitkeep
!output/tier3/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# 临时文件
*.tmp
*.bak
/tmp/
