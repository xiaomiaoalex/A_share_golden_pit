# Platform database. When omitted, existing golden_pit.db installations are
# reused; new installations default to data/db/strategy_platform.db.
STRATEGY_PLATFORM_DB=

# Golden Pit strategy source order. TIER1_DATA_SOURCES remains a legacy alias.
GOLDEN_PIT_DATA_SOURCES=akshare,tushare,baostock
TUSHARE_TOKEN=

# Stage B keeps external AI calls manual by default. Credentials are never
# committed; these settings are reserved for a future opt-in adapter.
AI_PROVIDER=manual
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
