# Platform database. When omitted, existing golden_pit.db installations are
# reused; new installations default to data/db/strategy_platform.db.
STRATEGY_PLATFORM_DB=
# 非本机部署必须设置；变更接口要求 X-Platform-Token 请求头。
PLATFORM_API_TOKEN=

# Golden Pit strategy source order. TIER1_DATA_SOURCES remains a legacy alias.
GOLDEN_PIT_DATA_SOURCES=akshare,tushare,baostock
TUSHARE_TOKEN=

# AI 研究默认中国模型优先；密钥只由后端读取，不返回浏览器或写入日志。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-128k
# 境外模型仅在 ModelPolicy.allow_external=true 且字段策略允许时调用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
