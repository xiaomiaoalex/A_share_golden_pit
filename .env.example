# Tier1 v2 source order. The application reads environment variables directly;
# this file is documentation only and contains no credential.
TIER1_DATA_SOURCES=akshare,tushare,baostock
TUSHARE_TOKEN=

# Stage B keeps external AI calls manual by default. Credentials are never
# committed; these settings are reserved for a future opt-in adapter.
AI_PROVIDER=manual
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
